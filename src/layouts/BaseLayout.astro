---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config';
import '../styles/global.css';
interface Props {
  title?: string; description?: string; image?: string;
  lang?: 'zh-Hans' | 'en'; article?: boolean; published?: string; modified?: string;
  alternates?: { lang: string; href: string }[]; noindex?: boolean;
}
const { title = siteConfig.title, description = siteConfig.description, image, lang = 'zh-Hans', article = false, published, modified, alternates = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const preview = import.meta.env.CF_PAGES === '1' && import.meta.env.CF_PAGES_BRANCH !== 'main';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="高瑜泽的文章" href="/rss.xml" />
    {alternates.map(item => <link rel="alternate" hreflang={item.lang === 'zh' ? 'zh-Hans' : 'en'} href={new URL(item.href, siteConfig.url).href} />)}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    {image && <meta property="og:image" content={new URL(image, siteConfig.url).href} />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={new URL(image, siteConfig.url).href} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
