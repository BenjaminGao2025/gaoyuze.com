---
import { articleHref, formatDate, getReadingStats, type ArticleEntry } from '../utils/content';
interface Props { article: ArticleEntry; languages?: string[]; }
const { article, languages = [] } = Astro.props;
const { data } = article;
const stats = getReadingStats(article.body, data.lang);
---
<article class="article-row" lang={data.lang === 'zh' ? 'zh-Hans' : 'en'}>
  <div class="item-meta"><time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time><span>{stats.minutes}</span>{data.lang === 'en' && <span lang="en">English</span>}</div>
  <h2><a href={articleHref(article)}>{data.title}</a></h2>
  {data.summary && <p class="summary">{data.summary}</p>}
  <div class="row-bottom">
    <ul class="tag-list" aria-label="标签">{data.tags.map(tag => <li><a href={`/search/?q=${encodeURIComponent(tag)}`}>{tag}</a></li>)}</ul>
    {languages.length > 1 && <span class="translation-note">{languages.join(' / ')}</span>}
  </div>
</article>
