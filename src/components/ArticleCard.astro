---
import { articleHref, formatDate, getReadingStats, type ArticleEntry } from '../utils/content';
interface Props { article: ArticleEntry; languages?: string[]; }
const { article, languages = [] } = Astro.props;
const { data } = article;
const stats = getReadingStats(article.body, data.lang);
const iso = data.date.toISOString().slice(0, 10);
const tags = [...new Set(data.tags.map(tag => tag.trim()).filter(Boolean))];
---
<article class="article-row" lang={data.lang === 'zh' ? 'zh-Hans' : 'en'}>
  <time class="entry-date" datetime={iso} aria-label={formatDate(data.date, data.lang)}><span>{iso.slice(0, 4)}</span><strong>{iso.slice(5).replace('-', '.')}</strong></time>
  <div class="entry-content">
    <h2><a href={articleHref(article)}>{data.title}</a></h2>
    {data.summary && <p class="summary">{data.summary}</p>}
    <div class="row-bottom">
      <span class="item-meta">{stats.minutes}</span>
      {tags.length > 0 && <ul class="tag-list" aria-label={data.lang === 'zh' ? '标签' : 'Tags'}>{tags.map(tag => <li><a href={`/search/?q=${encodeURIComponent(tag)}`}>{tag}</a></li>)}</ul>}
      {languages.length > 1 ? <span class="translation-note">{languages.join(' / ')}</span> : data.lang === 'en' && <span class="translation-note" lang="en">English</span>}
    </div>
  </div>
</article>
