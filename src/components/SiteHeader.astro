---
import { siteConfig } from '../config';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href="/">高瑜泽<span lang="en">Gao Yuze</span></a>
  <nav class="site-nav" aria-label="主导航">
    {siteConfig.nav.map(item => <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>
