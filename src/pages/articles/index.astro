---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles, getCanonicalArticles, getArticleLanguages } from '../../utils/content';
const all = await getPublishedArticles();
const articles = getCanonicalArticles(all);
---
<BaseLayout title="文章 · 高瑜泽" description="高瑜泽的全部文章，记录生活、学习与实践。">
  <header class="page-heading"><p class="eyebrow">Writing</p><h1>文章</h1><p>长一点的思考，短一点的记录，都留在这里。</p></header>
  <div class="list-tools"><span>共 {articles.length} 篇 · 中文优先显示</span><a href="/search/">搜索文章 →</a></div>
  <div class="article-list">{articles.map(article => <ArticleCard article={article} languages={getArticleLanguages(article, all).map(item => item.label)} />)}</div>
  {!articles.length && <p class="empty">还没有公开的文章。</p>}
</BaseLayout>
