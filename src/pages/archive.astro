---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedArticles, getCanonicalArticles, articleHref } from '../utils/content';
const articles = getCanonicalArticles(await getPublishedArticles());
const years = [...new Set(articles.map(article => article.data.date.getUTCFullYear()))];
---
<BaseLayout title="归档 · 高瑜泽" description="按年份查找高瑜泽的文章。">
  <header class="page-heading"><p class="eyebrow">Archive</p><h1>归档</h1><p>写过的东西，按时间放好。</p></header>
  {years.map(year => <section class="archive-year"><h2>{year}</h2><ol>{articles.filter(a => a.data.date.getUTCFullYear() === year).map(article => <li><time datetime={article.data.date.toISOString().slice(0, 10)}>{article.data.date.toISOString().slice(5, 10)}</time><a href={articleHref(article)} lang={article.data.lang === 'zh' ? 'zh-Hans' : 'en'}>{article.data.title}</a>{article.data.lang === 'en' && <span class="translation-note">EN</span>}</li>)}</ol></section>)}
  {!articles.length && <p class="empty">还没有公开的文章。</p>}
</BaseLayout>
