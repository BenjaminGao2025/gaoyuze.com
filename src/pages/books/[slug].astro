---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBookStatusLabel, type BookEntry } from '../../utils/content';
export async function getStaticPaths() {
  return (await getCollection('books')).map(book => ({ params: { slug: book.data.pageSlug }, props: { book } }));
}
interface Props { book: BookEntry; }
const { book } = Astro.props;
const { Content } = await render(book);
---
<BaseLayout title={`${book.data.title} · 高瑜泽`} description={book.data.summary} lang={book.data.lang === 'en' ? 'en' : 'zh-Hans'}>
  <article class="reading-page"><header class="reading-header"><a class="back-link" href="/books/">← 旧书架</a><p class="item-meta">{book.data.year} · {getBookStatusLabel(book.data.status)}</p><h1>{book.data.title}</h1><p class="article-summary">{book.data.summary}</p></header>
    <div class="prose"><Content /></div>
    {book.data.chapters.length > 0 && <section class="chapter-list"><h2>章节计划</h2><ol>{book.data.chapters.map(chapter => <li>{chapter.href ? <a href={chapter.href}>{chapter.title}</a> : <span>{chapter.title}</span>}{chapter.status && <small>{chapter.status}</small>}</li>)}</ol></section>}
  </article>
</BaseLayout>
