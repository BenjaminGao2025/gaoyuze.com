  /* 指法色彩规范 (柔和自然淡彩，不辣眼) */
  .color-lp, .f-lp { --finger-bg: #f5eeea; --finger-border: #e2d2ca; } /* 左手小指：淡米桃 */
  .color-lr, .f-lr { --finger-bg: #f8f1e5; --finger-border: #ecdac0; } /* 左手无名：淡杏橙 */
  .color-lm, .f-lm { --finger-bg: #f3f7ea; --finger-border: #dce7c9; } /* 左手中指：淡黄绿 */
  .color-li, .f-li { --finger-bg: #eaf6f4; --finger-border: #c9e7e2; } /* 左手食指：淡青水 */
  .color-th, .f-th { --finger-bg: #f4f4f4; --finger-border: #dedede; } /* 大拇指：纯净灰 */
  .color-ri, .f-ri { --finger-bg: #eef4f9; --finger-border: #d2e3f2; } /* 右手食指：淡天蓝 */
  .color-rm, .f-rm { --finger-bg: #f1eff8; --finger-border: #dcd8ee; } /* 右手中指：淡浅紫 */
  .color-rr, .f-rr { --finger-bg: #f8eff6; --finger-border: #eed7e9; } /* 右手无名：淡丁香 */
  .color-rp, .f-rp { --finger-bg: #fbeeef; --finger-border: #f6d4d7; } /* 右手小指：淡粉红 */

  .legend-dot.color-lp { background: #e2d2ca; }
