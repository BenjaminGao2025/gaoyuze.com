  const KEY_GUIDE_MAP: Record<string, KeyGuide> = {
    // 标点陷阱
    "'": { code: "Comma", shift: true, shiftKey: "ShiftLeft", desc: "⚠️ 标点搬家：【Shift + ,】（别按原单引号键，那是 è！）", finger: "左手小指按 Shift + 右手中指按逗号" },
    "?": { code: "Digit6", shift: true, shiftKey: "ShiftLeft", desc: "⚠️ 标点搬家：【Shift + 6】（别按 / 键，那是 é！）", finger: "左手小指按 Shift + 右手食指按 6" },
    '"': { code: "Period", shift: true, shiftKey: "ShiftLeft", desc: "标点搬家：【Shift + .】", finger: "左手小指按 Shift + 右手无名指按句号" },

    // 四大直出变音
    "é": { code: "Slash", shift: false, desc: "四大直出：直接按物理【/?】键", finger: "右手小指" },
    "É": { code: "Slash", shift: true, shiftKey: "ShiftLeft", desc: "四大直出：按【Shift + /?】", finger: "左手小指按 Shift + 右手小指" },
    "è": { code: "Quote", shift: false, desc: "四大直出：直接按物理【'\"】键（回车左侧）", finger: "右手小指" },
    "È": { code: "Quote", shift: true, shiftKey: "ShiftLeft", desc: "四大直出：按【Shift + '\"】", finger: "左手小指按 Shift + 右手小指" },
    "à": { code: "Backslash", shift: false, desc: "四大直出：直接按物理【\\|】键（回车上方）", finger: "右手小指" },
    "À": { code: "Backslash", shift: true, shiftKey: "ShiftLeft", desc: "四大直出：按【Shift + \\|】", finger: "左手小指按 Shift + 右手小指" },
    "ç": { code: "BracketRight", shift: false, desc: "四大直出：直接按物理【]}】键", finger: "右手小指" },
    "Ç": { code: "BracketRight", shift: true, shiftKey: "ShiftLeft", desc: "四大直出：按【Shift + ]}】", finger: "左手小指按 Shift + 右手小指" },

    // 死键组合 (两步法)
    "ê": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: false }, vowelStep: { code: "KeyE" }, desc: "死键长音：第 1 步先按【[】(^)，第 2 步按【e】", finger: "右手小指按 [ ➔ 左手中指按 E" },
    "â": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: false }, vowelStep: { code: "KeyA" }, desc: "死键长音：第 1 步先按【[】(^)，第 2 步按【a】", finger: "右手小指按 [ ➔ 左手小指按 A" },
    "î": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: false }, vowelStep: { code: "KeyI" }, desc: "死键长音：第 1 步先按【[】(^)，第 2 步按【i】", finger: "右手小指按 [ ➔ 右手中指按 I" },
    "ô": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: false }, vowelStep: { code: "KeyO" }, desc: "死键长音：第 1 步先按【[】(^)，第 2 步按【o】", finger: "右手小指按 [ ➔ 右手无名指按 O" },
    "û": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: false }, vowelStep: { code: "KeyU" }, desc: "死键长音：第 1 步先按【[】(^)，第 2 步按【u】", finger: "右手小指按 [ ➔ 右手食指按 U" },

    "ë": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: true }, vowelStep: { code: "KeyE" }, desc: "死键分音：第 1 步按【Shift + [】(¨)，第 2 步按【e】", finger: "左小指Shift + 右小指[ ➔ 左手中指E" },
    "ï": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: true }, vowelStep: { code: "KeyI" }, desc: "死键分音：第 1 步按【Shift + [】(¨)，第 2 步按【i】", finger: "左小指Shift + 右小指[ ➔ 右手中指I" },
    "ü": { code: "BracketLeft", isDead: true, deadStep: { code: "BracketLeft", shift: true }, vowelStep: { code: "KeyU" }, desc: "死键分音：第 1 步按【Shift + [】(¨)，第 2 步按【u】", finger: "左小指Shift + 右小指[ ➔ 右手食指U" },

    // 基础符号
    " ": { code: "Space", desc: "按【空格键】", finger: "大拇指" },
    ",": { code: "Comma", desc: "按【逗号键】", finger: "右手中指" },
    ".": { code: "Period", desc: "按【句号键】", finger: "右手无名指" },
    ";": { code: "Semicolon", desc: "按【分号键】", finger: "右手小指" },
    ":": { code: "Semicolon", shift: true, shiftKey: "ShiftLeft", desc: "按【Shift + 分号】", finger: "左手小指按 Shift + 右手小指" },
    "!": { code: "Digit1", shift: true, shiftKey: "ShiftRight", desc: "按【Shift + 1】", finger: "右手小指按 Shift + 左手小指" },
    "-": { code: "Minus", desc: "按【减号键】", finger: "右手小指" }
  };

  // 生成 A-Z 字母指法表
  const LETTERS: Record<string, { code: string; finger: string; rightHand?: boolean }> = {
    a: { code: "KeyA", finger: "左手小指" }, b: { code: "KeyB", finger: "左手食指" },
    c: { code: "KeyC", finger: "左手中指" }, d: { code: "KeyD", finger: "左手中指" },
    e: { code: "KeyE", finger: "左手中指" }, f: { code: "KeyF", finger: "左手食指" },
    g: { code: "KeyG", finger: "左手食指" }, h: { code: "KeyH", finger: "右手食指", rightHand: true },
    i: { code: "KeyI", finger: "右手中指", rightHand: true }, j: { code: "KeyJ", finger: "右手食指", rightHand: true },
    k: { code: "KeyK", finger: "右手中指", rightHand: true }, l: { code: "KeyL", finger: "右手无名指", rightHand: true },
    m: { code: "KeyM", finger: "右手食指", rightHand: true }, n: { code: "KeyN", finger: "右手食指", rightHand: true },
    o: { code: "KeyO", finger: "右手无名指", rightHand: true }, p: { code: "KeyP", finger: "右手小指", rightHand: true },
    q: { code: "KeyQ", finger: "左手小指" }, r: { code: "KeyR", finger: "左手食指" },
    s: { code: "KeyS", finger: "左手无名指" }, t: { code: "KeyT", finger: "左手食指" },
    u: { code: "KeyU", finger: "右手食指", rightHand: true }, v: { code: "KeyV", finger: "左手食指" },
    w: { code: "KeyW", finger: "左手无名指" }, x: { code: "KeyX", finger: "左手无名指" },
    y: { code: "KeyY", finger: "右手食指", rightHand: true }, z: { code: "KeyZ", finger: "左手小指" }
  };

  Object.entries(LETTERS).forEach(([letter, data]) => {
    KEY_GUIDE_MAP[letter] = {
      code: data.code,
      shift: false,
      desc: `按【${letter.toUpperCase()}】键`,
      finger: data.finger
    };
    KEY_GUIDE_MAP[letter.toUpperCase()] = {
      code: data.code,
      shift: true,
      shiftKey: data.rightHand ? "ShiftLeft" : "ShiftRight",
      desc: `大写字母：【Shift + ${letter.toUpperCase()}】`,
      finger: `${data.rightHand ? '左手小指' : '右手小指'}按 Shift + ${data.finger}`
    };
  });

  // 状态变量
  let currentMode = "accents";
  let currentPromptIndex = 0;
  let targetText = "";
  let typedText = "";
  let startTime: number | null = null;
  let errorCount = 0;
  let deadKeyInProgress = false;

  // DOM 元素引用
  const typingBox = document.getElementById("typing-box")!;
  const hiddenInput = document.getElementById("hidden-input") as HTMLInputElement;
  const textDisplay = document.getElementById("text-display")!;
  const hintText = document.getElementById("hint-text")!;
  const hintFingerBadge = document.getElementById("hint-finger-badge")!;
  const statWpm = document.getElementById("stat-wpm")!;
  const statAcc = document.getElementById("stat-acc")!;
  const statProg = document.getElementById("stat-prog")!;
  const btnRestart = document.getElementById("btn-restart")!;
  const btnNext = document.getElementById("btn-next")!;
  const modeTabs = document.querySelectorAll<HTMLButtonElement>(".mode-tab");
  const customDrawer = document.getElementById("custom-drawer")!;
  const customTextInput = document.getElementById("custom-text-input") as HTMLTextAreaElement;
  const btnLoadCustom = document.getElementById("btn-load-custom")!;
  const toggleCheatBtn = document.getElementById("toggle-cheat")!;
  const cheatBody = document.getElementById("cheat-body")!;
  const toggleFingerColorsBtn = document.getElementById("toggle-finger-colors")!;
  const physicalKeyboard = document.getElementById("physical-keyboard")!;
  const allKeys = document.querySelectorAll<HTMLElement>(".k-key");

  // 折叠速查卡
  toggleCheatBtn.addEventListener("click", () => {
    const isHidden = cheatBody.hasAttribute("hidden");
    if (isHidden) {
      cheatBody.removeAttribute("hidden");
      toggleCheatBtn.textContent = "收起速查";
      toggleCheatBtn.setAttribute("aria-expanded", "true");
    } else {
      cheatBody.setAttribute("hidden", "");
      toggleCheatBtn.textContent = "展开速查";
      toggleCheatBtn.setAttribute("aria-expanded", "false");
    }
  });

  // 切换指法分区配色
  toggleFingerColorsBtn.addEventListener("click", () => {
    const hasClass = physicalKeyboard.classList.contains("show-fingers");
    if (hasClass) {
      physicalKeyboard.classList.remove("show-fingers");
      toggleFingerColorsBtn.textContent = "🎨 指法分区配色：关";
      toggleFingerColorsBtn.setAttribute("aria-pressed", "false");
    } else {
      physicalKeyboard.classList.add("show-fingers");
      toggleFingerColorsBtn.textContent = "🎨 指法分区配色：开";
      toggleFingerColorsBtn.setAttribute("aria-pressed", "true");
    }
  });

  // 模式切换
  modeTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      modeTabs.forEach(t => {
        t.classList.remove("active");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");
      currentMode = tab.dataset.mode!;
      currentPromptIndex = 0;
      if (currentMode === "custom") {
        customDrawer.removeAttribute("hidden");
      } else {
        customDrawer.setAttribute("hidden", "");
      }
      initLevel();
    });
  });

  btnLoadCustom.addEventListener("click", () => {
    const val = customTextInput.value.trim();
    if (val) {
      targetText = val;
      resetState();
      renderText();
      hiddenInput.focus();
    }
  });

  btnRestart.addEventListener("click", () => {
    resetState();
    renderText();
    hiddenInput.focus();
  });

  btnNext.addEventListener("click", () => {
    if (currentMode !== "custom") {
      const list = DRILL_SETS[currentMode] || [];
      currentPromptIndex = (currentPromptIndex + 1) % list.length;
    }
    initLevel();
  });

  function initLevel() {
    if (currentMode === "custom") {
      targetText = customTextInput.value.trim() || "C'est la vie ! Où est la bibliothèque ?";
    } else {
      const list = DRILL_SETS[currentMode] || [];
      targetText = list[currentPromptIndex] || list[0] || "";
    }
    resetState();
    renderText();
    hiddenInput.focus();
  }

  function resetState() {
    typedText = "";
    hiddenInput.value = "";
    startTime = null;
    errorCount = 0;
    deadKeyInProgress = false;
    updateStats();
    clearKeyboardHighlight();
  }

  function renderText() {
    textDisplay.innerHTML = "";
    const targetChars = Array.from(targetText);
    const typedChars = Array.from(typedText);

    targetChars.forEach((ch, idx) => {
      const span = document.createElement("span");
      span.className = "char";
      span.textContent = ch;

      if (idx < typedChars.length) {
        if (typedChars[idx] === ch) {
          span.classList.add("correct");
        } else {
          span.classList.add("incorrect");
        }
      } else if (idx === typedChars.length) {
        span.classList.add("current");
      }
      textDisplay.appendChild(span);
    });

    updateHintAndKeyboard();
  }

  function updateHintAndKeyboard() {
    clearKeyboardHighlight();
    const currIndex = typedText.length;
    if (currIndex >= targetText.length) {
      hintText.innerHTML = "🎉 <strong>恭喜完成！</strong> 点击【换一组内容】或按 Esc 重新开始。";
      hintFingerBadge.textContent = "完成";
      return;
    }

    const nextChar = targetText[currIndex];
    const guide = KEY_GUIDE_MAP[nextChar];

    if (guide) {
      hintText.innerHTML = `<strong>${nextChar === ' ' ? '␣ 空格' : nextChar}</strong>：${guide.desc}`;
      hintFingerBadge.textContent = guide.finger;

      if (guide.isDead) {
        if (!deadKeyInProgress) {
          highlightKey(guide.deadStep!.code, guide.deadStep!.shift ? "ShiftLeft" : undefined);
        } else {
          highlightKey(guide.vowelStep!.code);
        }
      } else {
        highlightKey(guide.code, guide.shift ? (guide.shiftKey || "ShiftLeft") : undefined);
      }
    } else {
      hintText.textContent = `下一个字符：${nextChar}`;
      hintFingerBadge.textContent = "自由敲击";
    }
  }

  function highlightKey(code: string, shiftCode?: string) {
    const targetKeyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${code}"]`);
    if (targetKeyEl) targetKeyEl.classList.add("active-target");

    if (shiftCode) {
      const shiftKeyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${shiftCode}"]`);
      if (shiftKeyEl) shiftKeyEl.classList.add("active-shift");
    }
  }

  function clearKeyboardHighlight() {
    allKeys.forEach(k => {
      k.classList.remove("active-target", "active-shift");
    });
  }

  function updateStats() {
    statProg.textContent = `${typedText.length} / ${targetText.length}`;
    if (!startTime || typedText.length === 0) {
      statWpm.textContent = "0";
      statAcc.textContent = "100%";
      return;
    }

    const elapsedMinutes = (Date.now() - startTime) / 60000;
    const words = typedText.length / 5;
    const wpm = elapsedMinutes > 0 ? Math.round(words / elapsedMinutes) : 0;
    statWpm.textContent = String(wpm);

    const totalTyped = typedText.length + errorCount;
    const acc = totalTyped > 0 ? Math.round((typedText.length / totalTyped) * 100) : 100;
    statAcc.textContent = `${acc}%`;
  }

  // 聚焦
  typingBox.addEventListener("click", () => hiddenInput.focus());

  // 捕获物理键盘按下 (TypingClub 风格即时物理按压下沉动画)
  window.addEventListener("keydown", (e: KeyboardEvent) => {
    // 查找对应物理键
    const keyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${e.code}"]`);
    if (keyEl) keyEl.classList.add("pressed");

    // Shift 联动换挡
    if (e.key === "Shift") {
      physicalKeyboard.classList.add("keyboard-shifted");
    }

    if (e.key === "Escape") {
      resetState();
      renderText();
      hiddenInput.focus();
    }

    // 监听死键按压 (如按下了 [ 键)
    if (e.code === "BracketLeft") {
      deadKeyInProgress = true;
      updateHintAndKeyboard();
    }
  });

  window.addEventListener("keyup", (e: KeyboardEvent) => {
    const keyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${e.code}"]`);
    if (keyEl) keyEl.classList.remove("pressed");

    if (e.key === "Shift") {
      physicalKeyboard.classList.remove("keyboard-shifted");
    }
  });

  // 捕获真实文本输入
  hiddenInput.addEventListener("input", () => {
    if (!startTime) startTime = Date.now();
    deadKeyInProgress = false;
    const val = hiddenInput.value;

    if (val.length < typedText.length) {
      // 退格
      typedText = val;
    } else {
      const addedChar = val.slice(typedText.length);
      const expectedChar = targetText.slice(typedText.length, typedText.length + addedChar.length);

      if (addedChar !== expectedChar) {
        errorCount++;
      }
      typedText = val;
    }

    updateStats();
    renderText();

    // 如果完成当前句子
    if (typedText.length >= targetText.length) {
      if (currentMode !== "custom") {
        const list = DRILL_SETS[currentMode] || [];
        if (currentPromptIndex < list.length - 1) {
          setTimeout(() => {
            currentPromptIndex++;
            initLevel();
          }, 600);
        }
      }
    }
  });

  // 初始启动
  initLevel();
</script>
