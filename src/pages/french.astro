    overflow: hidden;
    transition: transform 0.05s ease, box-shadow 0.05s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .show-fingers .k-key:not(.k-mod):not(.active-target):not(.active-shift):not(.pressed) {
    background: var(--finger-bg, #fff);
    border-color: var(--finger-border, #cbd5e1);
    box-shadow: 0 3px 0 var(--finger-border, #cbd5e1), 0 3px 4px rgba(0,0,0,0.04);
  }

  /* 特殊键宽定义 (标准 ANSI 比例) */
  .k-w-backspace { flex: 2 2 0; }
  .k-w-tab       { flex: 1.5 1.5 0; }
  .k-w-backslash { flex: 1.5 1.5 0; }
  .k-w-caps      { flex: 1.75 1.75 0; }
  .k-w-enter     { flex: 2.25 2.25 0; }
  .k-w-lshift    { flex: 2.25 2.25 0; }
  .k-w-rshift    { flex: 2.75 2.75 0; }
  .k-w-ctrl      { flex: 1.25 1.25 0; }
  .k-w-opt       { flex: 1.25 1.25 0; }
  .k-w-cmd       { flex: 1.5 1.5 0; }
  .k-w-space     { flex: 6 6 0; }

  /* 键帽内部字符排版 (防溢出、防折行) */
  .k-phys {
    font-size: 0.5625rem;
