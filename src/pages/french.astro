    m: { code: "KeyM", finger: "右手食指", rightHand: true }, n: { code: "KeyN", finger: "右手食指", rightHand: true },
    o: { code: "KeyO", finger: "右手无名指", rightHand: true }, p: { code: "KeyP", finger: "右手小指", rightHand: true },
    q: { code: "KeyQ", finger: "左手小指" }, r: { code: "KeyR", finger: "左手食指" },
    s: { code: "KeyS", finger: "左手无名指" }, t: { code: "KeyT", finger: "左手食指" },
    u: { code: "KeyU", finger: "右手食指", rightHand: true }, v: { code: "KeyV", finger: "左手食指" },
    w: { code: "KeyW", finger: "左手无名指" }, x: { code: "KeyX", finger: "左手无名指" },
    y: { code: "KeyY", finger: "右手食指", rightHand: true }, z: { code: "KeyZ", finger: "左手小指" }
  };

  Object.entries(LETTERS).forEach(([letter, data]) => {
    KEY_GUIDE_MAP[letter] = { code: data.code, shift: false, desc: `按【${letter.toUpperCase()}】键`, finger: data.finger };
    KEY_GUIDE_MAP[letter.toUpperCase()] = { code: data.code, shift: true, shiftKey: data.rightHand ? "ShiftLeft" : "ShiftRight", desc: `大写字母：【Shift + ${letter.toUpperCase()}】`, finger: `${data.rightHand ? '左小指' : '右小指'} Shift + ${data.finger}` };
  });

  // 音频引擎 (Web Audio API 原生合成音)
  class SoundEngine {
    private ctx: AudioContext | null = null;
    enabled = true;

    init() {
      if (!this.ctx && typeof window !== "undefined") {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
    }

    playClick() {
      if (!this.enabled || !this.ctx) return;
      try {
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(650, this.ctx.currentTime);
        gain.gain.setValueAtTime(0.04, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.03);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.03);
      } catch {}
    }

    playError() {
      if (!this.enabled || !this.ctx) return;
      try {
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(140, this.ctx.currentTime);
        gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.08);
      } catch {}
    }

    playSuccessChime() {
      if (!this.enabled || !this.ctx) return;
      try {
        const now = this.ctx.currentTime;
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
          const osc = this.ctx!.createOscillator();
          const gain = this.ctx!.createGain();
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);
          gain.gain.setValueAtTime(0.06, now + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.35);
          osc.connect(gain);
          gain.connect(this.ctx!.destination);
          osc.start(now + idx * 0.08);
          osc.stop(now + idx * 0.08 + 0.35);
        });
      } catch {}
    }
  }

  const sound = new SoundEngine();

  // 课程持久化存储结构
  interface LessonProgress {
    stars: number;
    wpm: number;
    accuracy: number;
    completed: boolean;
  }
  const STORAGE_KEY = "csa_french_course_v2";

  function getSavedProgress(): Record<number, LessonProgress> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  }

  function saveProgress(id: number, stars: number, wpm: number, accuracy: number) {
    try {
      const all = getSavedProgress();
      const prev = all[id] || { stars: 0, wpm: 0, accuracy: 0, completed: false };
      all[id] = {
        stars: Math.max(prev.stars, stars),
        wpm: Math.max(prev.wpm, wpm),
        accuracy: Math.max(prev.accuracy, accuracy),
        completed: true
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(all));
      updateTotalStarsBadge();
    } catch {}
  }

  // 状态机
  let isCourseMode = true;
  let activeLessonId = 1;
  let currentDrillIndex = 0;
  let currentDrillList: string[] = [];
  let targetText = "";
  let typedText = "";
  let startTime: number | null = null;
  let errorCount = 0;
  let deadKeyInProgress = false;

  // DOM 引用
  const viewCourseMap = document.getElementById("view-course-map")!;
  const viewPlayStage = document.getElementById("view-play-stage")!;
  const viewDrillsStage = document.getElementById("view-drills-stage")!;
  const tabCourseView = document.getElementById("tab-course-view")!;
  const tabPlayView = document.getElementById("tab-play-view")!;
  const tabDrillsView = document.getElementById("tab-drills-view")!;
  const unitsContainer = document.getElementById("units-container")!;
  const totalStarsCount = document.getElementById("total-stars-count")!;
  const toggleSoundBtn = document.getElementById("toggle-sound")!;
  const toggleFingerColorsBtn = document.getElementById("toggle-finger-colors")!;
  const btnContinueJourney = document.getElementById("btn-continue-journey")!;

  const lessonTag = document.getElementById("lesson-tag")!;
  const lessonTitle = document.getElementById("lesson-title")!;
  const lessonKeys = document.getElementById("lesson-keys")!;
  const lessonTarget = document.getElementById("lesson-target")!;
  const btnBackToMap = document.getElementById("btn-back-to-map")!;
  const btnRestartLesson = document.getElementById("btn-restart-lesson")!;

  const typingBox = document.getElementById("typing-box")!;
  const hiddenInput = document.getElementById("hidden-input") as HTMLInputElement;
  const textDisplay = document.getElementById("text-display")!;
  const hintText = document.getElementById("hint-text")!;
  const hintFingerBadge = document.getElementById("hint-finger-badge")!;
  const statDrillStep = document.getElementById("stat-drill-step")!;
  const statWpm = document.getElementById("stat-wpm")!;
  const statAcc = document.getElementById("stat-acc")!;
  const statProg = document.getElementById("stat-prog")!;
  const physicalKeyboard = document.getElementById("physical-keyboard")!;
  const allKeys = document.querySelectorAll<HTMLElement>(".k-key");

  const customTextInput = document.getElementById("custom-text-input") as HTMLTextAreaElement;
  const btnLoadCustom = document.getElementById("btn-load-custom")!;

  const lessonModal = document.getElementById("lesson-modal")!;
  const modalLessonTitle = document.getElementById("modal-lesson-title")!;
  const modalLessonQuote = document.getElementById("modal-lesson-quote")!;
  const modalStars = document.getElementById("modal-stars")!;
  const modalWpm = document.getElementById("modal-wpm")!;
  const modalAcc = document.getElementById("modal-acc")!;
  const modalTime = document.getElementById("modal-time")!;
  const modalBtnRetry = document.getElementById("modal-btn-retry")!;
  const modalBtnNext = document.getElementById("modal-btn-next")!;
  const modalBtnClose = document.getElementById("modal-btn-close")!;

  // 渲染课程地图
  function renderCourseMap() {
    unitsContainer.innerHTML = "";
    const progress = getSavedProgress();

    // 按单元分组
    const unitsMap = new Map<number, LessonDef[]>();
    COURSE_LESSONS.forEach(l => {
      if (!unitsMap.has(l.unitNum)) unitsMap.set(l.unitNum, []);
      unitsMap.get(l.unitNum)!.push(l);
    });

    unitsMap.forEach((lessons) => {
      const uFirst = lessons[0];
      const block = document.createElement("div");
      block.className = "unit-block";

      const header = document.createElement("div");
      header.className = "unit-header";
      header.innerHTML = `
        <h3 class="unit-title">${uFirst.unitTitle}</h3>
        <span class="unit-subtitle">${uFirst.unitDesc}</span>
      `;
      block.appendChild(header);

      const grid = document.createElement("div");
      grid.className = "lessons-grid";

      lessons.forEach(l => {
        const prog = progress[l.id];
        const stars = prog ? prog.stars : 0;
        const card = document.createElement("div");
        card.className = `lesson-card ${prog?.completed ? 'completed' : ''} ${l.id === activeLessonId ? 'active-current' : ''}`;
        card.innerHTML = `
          <div class="card-top">
            <span class="card-num">第 ${String(l.id).padStart(2, '0')} 关</span>
            <span class="card-stars">
              <span class="${stars >= 1 ? 'star-filled' : ''}">★</span>
              <span class="${stars >= 2 ? 'star-filled' : ''}">★</span>
              <span class="${stars >= 3 ? 'star-filled' : ''}">★</span>
            </span>
          </div>
          <h4 class="card-title">${l.title}</h4>
          <div class="card-keys">聚焦：${l.focusKeys}</div>
          <div class="card-footer">
            <span>目标: ${l.targetWpm} WPM</span>
            <span>${prog ? `最高: ${prog.wpm} WPM` : '未开始'}</span>
          </div>
        `;
        card.addEventListener("click", () => {
          startCourseLesson(l.id);
        });
        grid.appendChild(card);
      });

      block.appendChild(grid);
      unitsContainer.appendChild(block);
    });

    updateTotalStarsBadge();
  }

  function updateTotalStarsBadge() {
    const progress = getSavedProgress();
    let total = 0;
    Object.values(progress).forEach(p => { total += (p.stars || 0); });
    totalStarsCount.textContent = String(total);
  }

  // 切换主视图
  function switchView(viewName: 'map' | 'play' | 'drills') {
    viewCourseMap.hidden = viewName !== 'map';
    viewPlayStage.hidden = viewName !== 'play';
    viewDrillsStage.hidden = viewName !== 'drills';

    tabCourseView.classList.toggle("active", viewName === 'map');
    tabCourseView.setAttribute("aria-selected", String(viewName === 'map'));
    tabPlayView.classList.toggle("active", viewName === 'play');
    tabPlayView.setAttribute("aria-selected", String(viewName === 'play'));
    tabDrillsView.classList.toggle("active", viewName === 'drills');
    tabDrillsView.setAttribute("aria-selected", String(viewName === 'drills'));

    if (viewName === 'play') {
      setTimeout(() => hiddenInput.focus(), 100);
    }
  }

  tabCourseView.addEventListener("click", () => switchView('map'));
  tabPlayView.addEventListener("click", () => switchView('play'));
  tabDrillsView.addEventListener("click", () => switchView('drills'));
  btnBackToMap.addEventListener("click", () => switchView('map'));

  // 启动课程关卡
  function startCourseLesson(lessonId: number) {
    isCourseMode = true;
    activeLessonId = lessonId;
    const l = COURSE_LESSONS.find(item => item.id === lessonId) || COURSE_LESSONS[0];
    currentDrillList = l.drills;
    currentDrillIndex = 0;

    lessonTag.textContent = `${l.unitTitle} · 第 ${String(l.id).padStart(2, '0')} 关`;
    lessonTitle.textContent = l.title;
    lessonKeys.textContent = `重点键：${l.focusKeys}`;
    lessonTarget.textContent = `目标：${l.targetWpm} WPM · 正确率 ≥ 95%`;

    loadCurrentDrillText();
    switchView('play');
    renderCourseMap();
  }

  function loadCurrentDrillText() {
    targetText = currentDrillList[currentDrillIndex] || "";
    typedText = "";
    hiddenInput.value = "";
    startTime = null;
    errorCount = 0;
    deadKeyInProgress = false;

    statDrillStep.textContent = `${currentDrillIndex + 1} / ${currentDrillList.length}`;
    updateStats();
    renderText();
    clearKeyboardHighlight();
    updateHintAndKeyboard();
    hiddenInput.focus();
  }

  // 继续未完成或最新关卡
  btnContinueJourney.addEventListener("click", () => {
    const prog = getSavedProgress();
    const nextUnfinished = COURSE_LESSONS.find(l => !prog[l.id]?.completed);
    startCourseLesson(nextUnfinished ? nextUnfinished.id : 1);
  });

  // 音效与配色切换
  toggleSoundBtn.addEventListener("click", () => {
    sound.init();
    sound.enabled = !sound.enabled;
    toggleSoundBtn.textContent = sound.enabled ? "🔊 音效：开" : "🔇 音效：关";
    toggleSoundBtn.setAttribute("aria-pressed", String(sound.enabled));
  });

  toggleFingerColorsBtn.addEventListener("click", () => {
    const hasClass = physicalKeyboard.classList.contains("show-fingers");
    physicalKeyboard.classList.toggle("show-fingers", !hasClass);
    toggleFingerColorsBtn.textContent = !hasClass ? "🎨 指法配色：开" : "🎨 指法配色：关";
    toggleFingerColorsBtn.setAttribute("aria-pressed", String(!hasClass));
  });

  // 自由题库与自定义输入
  document.querySelectorAll<HTMLButtonElement>(".drill-launch-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      isCourseMode = false;
      const key = btn.dataset.drill!;
      currentDrillList = CLASSIC_DRILLS[key] || ["C'est la vie !"];
      currentDrillIndex = 0;

      lessonTag.textContent = "自由专项练习";
      lessonTitle.textContent = btn.textContent || "专项训练";
      lessonKeys.textContent = "自由靶向突破";
      lessonTarget.textContent = "无星级考核限制";

      loadCurrentDrillText();
      switchView('play');
    });
  });

  btnLoadCustom.addEventListener("click", () => {
    const val = customTextInput.value.trim();
    if (val) {
      isCourseMode = false;
      currentDrillList = [val];
      currentDrillIndex = 0;

      lessonTag.textContent = "自定义练习";
      lessonTitle.textContent = "个人专属文本输入";
      lessonKeys.textContent = "自由词句";
      lessonTarget.textContent = "无星级考核限制";

      loadCurrentDrillText();
      switchView('play');
    }
  });

  btnRestartLesson.addEventListener("click", () => {
    loadCurrentDrillText();
  });

  // 打字渲染逻辑
  function renderText() {
    textDisplay.innerHTML = "";
    const targetChars = Array.from(targetText);
    const typedChars = Array.from(typedText);

    targetChars.forEach((ch, idx) => {
      const span = document.createElement("span");
      span.className = "char";
      span.textContent = ch;

      if (idx < typedChars.length) {
        if (typedChars[idx] === ch) {
          span.classList.add("correct");
        } else {
          span.classList.add("incorrect");
        }
      } else if (idx === typedChars.length) {
        span.classList.add("current");
      }
      textDisplay.appendChild(span);
    });

    updateHintAndKeyboard();
  }

  function updateHintAndKeyboard() {
    clearKeyboardHighlight();
    const currIndex = typedText.length;
    if (currIndex >= targetText.length) {
      hintText.innerHTML = "✨ 本组已完成，准备进入下一组！";
      hintFingerBadge.textContent = "即将过渡";
      return;
    }

    const nextChar = targetText[currIndex];
    const guide = KEY_GUIDE_MAP[nextChar];

    if (guide) {
      hintText.innerHTML = `<strong>${nextChar === ' ' ? '␣ 空格' : nextChar}</strong>：${guide.desc}`;
      hintFingerBadge.textContent = guide.finger;

      if (guide.isDead) {
        if (!deadKeyInProgress) {
          highlightKey(guide.deadStep!.code, guide.deadStep!.shift ? "ShiftLeft" : undefined);
        } else {
          highlightKey(guide.vowelStep!.code);
        }
      } else {
        highlightKey(guide.code, guide.shift ? (guide.shiftKey || "ShiftLeft") : undefined);
      }
    } else {
      hintText.textContent = `下一个字符：${nextChar}`;
      hintFingerBadge.textContent = "自由敲击";
    }
  }

  function highlightKey(code: string, shiftCode?: string) {
    const targetKeyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${code}"]`);
    if (targetKeyEl) targetKeyEl.classList.add("active-target");

    if (shiftCode) {
      const shiftKeyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${shiftCode}"]`);
      if (shiftKeyEl) shiftKeyEl.classList.add("active-shift");
    }
  }

  function clearKeyboardHighlight() {
    allKeys.forEach(k => {
      k.classList.remove("active-target", "active-shift");
    });
  }

  function updateStats() {
    statProg.textContent = `${typedText.length} / ${targetText.length}`;
    if (!startTime || typedText.length === 0) {
      statWpm.textContent = "0 WPM";
      statAcc.textContent = "100%";
      return;
    }

    const elapsedMinutes = (Date.now() - startTime) / 60000;
    const words = typedText.length / 5;
    const wpm = elapsedMinutes > 0 ? Math.round(words / elapsedMinutes) : 0;
    statWpm.textContent = `${wpm} WPM`;

    const totalTyped = typedText.length + errorCount;
    const acc = totalTyped > 0 ? Math.round((typedText.length / totalTyped) * 100) : 100;
    statAcc.textContent = `${acc}%`;
  }

  // 物理键盘联动与下沉
  window.addEventListener("keydown", (e: KeyboardEvent) => {
    sound.init();
    const keyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${e.code}"]`);
    if (keyEl) keyEl.classList.add("pressed");

    if (e.key === "Shift") {
      physicalKeyboard.classList.add("keyboard-shifted");
    }

    if (e.key === "Escape") {
      loadCurrentDrillText();
    }

    if (e.code === "BracketLeft") {
      deadKeyInProgress = true;
      updateHintAndKeyboard();
    }
  });

  window.addEventListener("keyup", (e: KeyboardEvent) => {
    const keyEl = document.querySelector<HTMLElement>(`.k-key[data-code="${e.code}"]`);
    if (keyEl) keyEl.classList.remove("pressed");

    if (e.key === "Shift") {
      physicalKeyboard.classList.remove("keyboard-shifted");
    }
  });

  // 聚焦
  typingBox.addEventListener("click", () => hiddenInput.focus());

  // 输入监听
  hiddenInput.addEventListener("input", () => {
    if (!startTime) startTime = Date.now();
    deadKeyInProgress = false;
    const val = hiddenInput.value;

    if (val.length < typedText.length) {
      typedText = val;
      sound.playClick();
    } else {
      const addedChar = val.slice(typedText.length);
      const expectedChar = targetText.slice(typedText.length, typedText.length + addedChar.length);

      if (addedChar === expectedChar) {
        sound.playClick();
      } else {
        errorCount++;
        sound.playError();
      }
      typedText = val;
    }

    updateStats();
    renderText();

    // 完成单句
    if (typedText.length >= targetText.length) {
      if (currentDrillIndex < currentDrillList.length - 1) {
        setTimeout(() => {
          currentDrillIndex++;
          loadCurrentDrillText();
        }, 350);
      } else {
        // 全关完成！
        setTimeout(() => {
          onLessonComplete();
        }, 350);
      }
    }
  });

  // 关卡完成结算
  function onLessonComplete() {
    sound.playSuccessChime();
    const elapsedSeconds = Math.max(1, Math.round(((Date.now() - (startTime || Date.now()))) / 1000));
    const words = targetText.length / 5;
    const finalWpm = Math.round((words / (elapsedSeconds / 60))) || 0;
    const totalTyped = targetText.length + errorCount;
    const finalAcc = totalTyped > 0 ? Math.round((targetText.length / totalTyped) * 100) : 100;

    let starsEarned = 1;
    if (finalAcc >= 95 && finalWpm >= 15) starsEarned = 2;
    if (finalAcc >= 98 && finalWpm >= 20) starsEarned = 3;

    if (isCourseMode) {
      saveProgress(activeLessonId, starsEarned, finalWpm, finalAcc);
      const l = COURSE_LESSONS.find(item => item.id === activeLessonId)!;
      modalLessonTitle.textContent = `第 ${activeLessonId} 关完成！`;
      modalLessonQuote.textContent = l.quote;
    } else {
      modalLessonTitle.textContent = "专项训练完成！";
      modalLessonQuote.textContent = "保持练习，手感将越来越流畅！";
    }

    // 渲染星星
    modalStars.innerHTML = `
      <span class="${starsEarned >= 1 ? 'star-active' : ''}">★</span>
      <span class="${starsEarned >= 2 ? 'star-active' : ''}">★</span>
      <span class="${starsEarned >= 3 ? 'star-active' : ''}">★</span>
    `;

    modalWpm.textContent = `${finalWpm} WPM`;
    modalAcc.textContent = `${finalAcc}%`;
    modalTime.textContent = `${elapsedSeconds}s`;

    lessonModal.removeAttribute("hidden");
  }

  // 模态弹窗交互
  modalBtnRetry.addEventListener("click", () => {
    lessonModal.setAttribute("hidden", "");
    currentDrillIndex = 0;
    loadCurrentDrillText();
  });

  modalBtnNext.addEventListener("click", () => {
    lessonModal.setAttribute("hidden", "");
    if (isCourseMode && activeLessonId < COURSE_LESSONS.length) {
      startCourseLesson(activeLessonId + 1);
    } else {
      switchView('map');
    }
  });

  modalBtnClose.addEventListener("click", () => {
    lessonModal.setAttribute("hidden", "");
    switchView('map');
  });

  // 初始化
  renderCourseMap();
  switchView('map');
</script>
