  .legend-dot.color-rr { background: #eed7e9; }
  .legend-dot.color-rp { background: #f6d4d7; }

  .physical-keyboard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    user-select: none;
    background: #e2e5e9;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid #d0d4dc;
  }
  .k-row {
    display: flex;
    gap: 6px;
  }

  /* 物理键帽基础样式 */
  .k-key {
    flex: 1 1 0;
    height: 50px;
    background: #fff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    box-shadow: 0 3px 0 #cbd5e1, 0 3px 4px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
