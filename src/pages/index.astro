---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles, getCanonicalArticles, getArticleLanguages } from '../utils/content';
const all = await getPublishedArticles();
const recent = getCanonicalArticles(all).slice(0, 8);
---
<BaseLayout>
  <section class="intro">
    <p class="eyebrow">个人博客 · 始于 2026</p>
    <h1>你好，我是高瑜泽。</h1>
    <p>记录生活、学习与实践，<br class="mobile-break" />也把一些事情想清楚。</p>
    <a class="quiet-link" href="/about/">关于这个网站 <span aria-hidden="true">↗</span></a>
  </section>
  <section aria-labelledby="recent-heading">
    <div class="section-heading"><h2 id="recent-heading">最近写的</h2><a href="/archive/">按年份查看 <span aria-hidden="true">→</span></a></div>
    <div class="article-list">{recent.map(article => <ArticleCard article={article} languages={getArticleLanguages(article, all).map(item => item.label)} />)}</div>
    {!recent.length && <p class="empty">还没有公开的文章。</p>}
    <a class="all-link" href="/articles/">查看全部文章 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
